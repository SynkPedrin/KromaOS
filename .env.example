# ─────────────────────────────────────────────────────────────
# KROMA OS — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env com valores reais.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (local: docker compose up -d)
DATABASE_URL="postgresql://kroma:kroma@localhost:5434/kroma?schema=public"

# URL pública da aplicação (usada nos links de convite)
APP_URL="http://localhost:3456"

# Segredo para assinar URLs locais de arquivos. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Protege a rotina agendada /api/cron/daily. Gere com: openssl rand -hex 24
CRON_SECRET=""

# ── Armazenamento de arquivos ──────────────────────────────────
# "s3" = qualquer serviço compatível com S3 (Cloudflare R2, AWS S3, SeaweedFS/MinIO local)
# "vercel-blob" = Blob store PRIVADO da Vercel (produção atual); exige BLOB_READ_WRITE_TOKEN
# "local" = disco do servidor (apenas desenvolvimento; não use em serverless)
STORAGE_DRIVER="s3"
S3_ENDPOINT="http://localhost:9100"          # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION="us-east-1"                        # R2: auto
S3_BUCKET="kroma-files"
S3_ACCESS_KEY_ID="kroma-dev-access"          # credenciais locais (docker/s3.json) — troque em produção
S3_SECRET_ACCESS_KEY="kroma-dev-secret-key"
S3_FORCE_PATH_STYLE="true"                   # R2/SeaweedFS/MinIO: true
# Criado pela Vercel ao conectar o Blob store ao projeto (só com STORAGE_DRIVER="vercel-blob")
BLOB_READ_WRITE_TOKEN=""
LOCAL_STORAGE_DIR=".storage"

# Limites de upload em MB
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_DOCUMENT_MB=30
UPLOAD_MAX_VIDEO_MB=500

# ── E-mail (Resend) ────────────────────────────────────────────
# Sem estas variáveis, convites são criados e o link é exibido para envio manual.
# E-mail por SMTP (tem prioridade sobre o Resend). Gmail: senha de app em
# https://myaccount.google.com/apppasswords (exige verificação em 2 etapas). Limite ~500/dia.
SMTP_HOST=""                                 # ex.: smtp.gmail.com
SMTP_PORT="465"
SMTP_USER=""                                 # ex.: voce@gmail.com
SMTP_PASS=""                                 # senha de app (16 letras), nunca a senha normal
SMTP_FROM=""                                 # ex.: "KROMA OS <voce@gmail.com>" (padrão: SMTP_USER)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""                         # ex.: "KROMA OS <os@seudominio.com.br>" (domínio verificado)

# ── Meta Ads (módulo Anúncios, somente leitura) ────────────────
# Sem META_APP_ID, META_APP_SECRET e META_TOKEN_ENCRYPTION_KEY o botão "Conectar Meta Ads" fica desabilitado.
META_APP_ID=""                               # ID do app em developers.facebook.com
META_APP_SECRET=""                           # NUNCA versionar; só no ambiente do servidor
META_GRAPH_API_VERSION="v26.0"               # versão estável da Graph API
META_OAUTH_REDIRECT_URI=""                   # padrão: APP_URL + /api/integrations/meta/callback
META_LOGIN_CONFIG_ID=""                      # opcional: Facebook Login for Business (config_id)
META_INITIAL_AD_ACCOUNT_ID=""                # opcional: conta destacada na tela de integração
META_TOKEN_ENCRYPTION_KEY=""                 # 32+ caracteres aleatórios: openssl rand -base64 48
META_WEBHOOK_VERIFY_TOKEN=""                 # reservado para webhooks (não usado nesta versão)
META_SYNC_CRON_SECRET=""                     # opcional: agendador externo a cada 30 min (Bearer)
